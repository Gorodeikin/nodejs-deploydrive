PORT=3000
NODE_ENV=development

# Preferred way to configure MongoDB. If set, this takes priority over the
# four separate MONGODB_* variables below.
MONGODB_URI=

# Legacy fallback, used only when MONGODB_URI is empty. All four variables
# below are required together in that case.
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_URL=
MONGODB_DB=

# Comma-separated list of allowed CORS origins, e.g.
# http://localhost:3000,https://example.com
ALLOWED_ORIGINS=http://localhost:3000
APP_DOMAIN=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ENABLE_CLOUDINARY=false

# Never commit real secret values in this file.
